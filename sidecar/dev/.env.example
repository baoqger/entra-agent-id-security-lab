# Local Dev Edition (Ollama) — Environment Variables
# Copy to .env and fill in your values

# Microsoft Entra Agent ID
TENANT_ID=
BLUEPRINT_APP_ID=
AGENT_CLIENT_ID=
CLIENT_SPA_APP_ID=

# Blueprint Client Credential (used by the auth sidecar)
# For local dev: SourceType=ClientSecret (set in docker-compose.yml)
# For production on Azure: use SignedAssertionFromManagedIdentity (zero secrets)
# See: https://github.com/AzureAD/microsoft-identity-web/wiki/Client-Credentials
BLUEPRINT_CLIENT_SECRET=

# Custom Weather API audience (run scripts/setup-weather-api-resource.ps1 -UpdateEnv)
# WEATHER_API_APP_ID=
# Optional override; compose defaults to api://${WEATHER_API_APP_ID}
# EXPECTED_AUDIENCE=

# Ollama (local LLM)
OLLAMA_MODEL=qwen2.5:1.5b
